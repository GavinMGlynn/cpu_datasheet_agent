# Dependencies / build
node_modules/
/dist/
/build/
*.tsbuildinfo

# Secrets
.env
.env.*
!.env.example

# Local data and caches (keyed network cache, SQLite DB, downloaded datasheets)
/cache/
/data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.pdf

# Logs
/logs/
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test output
/coverage/

# Golden-set working files: datasheet text and rendered pages, which are the
# manufacturers' copyright. The golden JSON files beside them hold only the
# values read out of them, with the page each came from.
/eval/golden/work/

# Browser-test output, and screenshot baselines taken anywhere but inside the
# pinned Playwright image. Only those baselines are committed (D78).
/test/e2e/.output/
/test/e2e/.report/
/test/e2e/__screenshots__/local/

# The browser tests' own data directory, rebuilt on every run.
/test/e2e/.data/
