# Copy to .env and fill in. .env is gitignored. Every variable the project reads
# is listed here; src/config.ts validates them at startup and fails loudly.
# Empty values are treated as unset.

# --- Digi-Key Product Information v4 (docs/REFERENCES.md R-01, R-02) ---
# OAuth2 client credentials from https://developer.digikey.com/
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# 1 to use the sandbox host, 0 (default) for production.
DIGIKEY_SANDBOX=0
# Sandbox apps carry their own credentials; the production pair is rejected by
# the sandbox host and vice versa. Only the selected pair is used.
DIGIKEY_SANDBOX_CLIENT_ID=
DIGIKEY_SANDBOX_CLIENT_SECRET=
# Locale headers. Site is a two-letter uppercase country code, language a
# two-letter lowercase code, currency a three-letter uppercase ISO 4217 code.
DIGIKEY_LOCALE_SITE=AU
DIGIKEY_LOCALE_LANGUAGE=en
DIGIKEY_LOCALE_CURRENCY=AUD

# --- Mouser Search API (R-03) ---
MOUSER_API_KEY=

# --- element14 / Farnell / Newark Product Search API (R-61) ---
# Free key, 2 calls per second and 1000 per day. A second parametric opinion
# for the parts it lists. No adapter is built yet; see docs/COMPLETION_PLAN.md.
FARNELL_API_KEY=
# Store the catalogue is read from. au.element14.com is the Australian store;
# uk.farnell.com and www.newark.com carry more of the parts we look at.
FARNELL_STORE=uk.farnell.com

# --- Nexar / Octopart (R-05, R-06) ---
# Disabled by default. The evaluation tier allows 100 parts for the lifetime of
# the account, so every call is expensive. Enable deliberately.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
NEXAR_ENABLED=0
# Hard ceiling on parts ever requested from Nexar (0-100). Default 90 keeps a
# reserve of 10.
NEXAR_BUDGET_LIMIT=90

# --- Claude (R-10, R-17) ---
ANTHROPIC_API_KEY=
# Model ID for extraction and verification runs. Default claude-opus-5.
AGENT_MODEL=claude-opus-5
# Effort: low | medium | high | xhigh | max. Default high.
AGENT_EFFORT=high

# --- Local storage and logging ---
# Root for the cache, SQLite database, ledger, and tokens. Relative paths are
# resolved against the working directory. Default ./data (gitignored).
DATA_DIR=./data
# debug | info | warn | error. Default info.
LOG_LEVEL=info
# 1 to enable live contract tests (npm run test:live sets this itself).
LIVE_TESTS=0
